timestamp=2026-11-14T13:27:41.502Z level=INFO run=bfe8f42e message=evaluated permission=bash pattern="cat << 'EOF' > /app/opt_fine2.py\nimport numpy as np\nfrom cad_env import CADModel, DesignProblem, FEASolver, inspect_design\nimport json\nimport copy\n\nproblem = DesignProblem.load_json(\"/app/problem.json\")\n\ndef load_from_json(path):\n    with open(path, \"r\") as f:\n        design = json.load(f)\n    actions = []\n    for act in design[\"actions\"]:\n        params = act[\"params\"]\n        if act[\"action_type\"] == \"polygon\":\n            pts = [(params[0], params[1]), (params[2], params[3]), (params[4], params[5])]\n            fillet = params[6]\n            actions.append({\"type\": \"poly\", \"points\": pts, \"fillet\": fillet})\n        elif act[\"action_type\"] == \"circle\":\n            actions.append({\"type\": \"circle\", \"x\": params[0], \"y\": params[1], \"r\": params[2]})\n    return actions\n\nbest_actions = load_from_json(\"/app/design.json\")\n\ndef make_model(actions):\n    model = CADModel(problem)\n    for act in actions:\n        if act[\"type\"] == \"poly\":\n            model.cut_polygon(act[\"points\"], act[\"fillet\"])\n        elif act[\"type\"] == \"circle\":\n            model.cut_circle(act[\"x\"], act[\"y\"], act[\"r\"])\n    return model\n\nbest_model = make_model(best_actions)\nbest_report = inspect_design(problem, best_model)\nbest_comp = best_report['total_compliance']\n\nprint(f\"Start: Vol: {best_report['volume_fraction']:.4f}, Comp: {best_comp:.2f}, Stress: {best_report['max_von_mises_stress']:.2f}\")\n\nfor i in range(2000):\n    new_actions = copy.deepcopy(best_actions)\n    \n    act_idx = np.random.randint(len(new_actions))\n    \n    if new_actions[act_idx][\"type\"] == \"poly\":\n        pt_idx = np.random.randint(len(new_actions[act_idx][\"points\"]))\n        dx = np.random.normal(0, 0.3)\n        dy = np.random.normal(0, 0.3)\n        if act_idx == 0:\n            if pt_idx == 1:\n                continue\n            if pt_idx == 0:\n                new_actions[act_idx][\"points\"][pt_idx] = (new_actions[act_idx][\"points\"][pt_idx][0] + dx, 30.0)\n            elif pt_idx == 2:\n                new_actions[act_idx][\"points\"][pt_idx] = (60.0, new_actions[act_idx][\"points\"][pt_idx][1] + dy)\n        else:\n            if pt_idx == 1: \n                new_actions[act_idx][\"points\"][pt_idx] = (new_actions[act_idx][\"points\"][pt_idx][0] + dx, 6.0)\n            else: \n                if pt_idx == 0:\n                    new_actions[act_idx][\"points\"][pt_idx] = (new_actions[act_idx][\"points\"][pt_idx][0] + dx, new_actions[act_idx][\"points\"][pt_idx][1] + dy)\n                    new_actions[act_idx][\"points\"][2] = (new_actions[act_idx][\"points\"][pt_idx][0], new_actions[act_idx][\"points\"][2][1])\n                elif pt_idx == 2:\n                    new_actions[act_idx][\"points\"][pt_idx] = (new_actions[act_idx][\"points\"][pt_idx][0] + dx, new_actions[act_idx][\"points\"][pt_idx][1] + dy)\n                    new_actions[act_idx][\"points\"][0] = (new_actions[act_idx][\"points\"][pt_idx][0], new_actions[act_idx][\"points\"][0][1])\n    else:\n        new_actions[act_idx][\"x\"] += np.random.normal(0, 0.5)\n        new_actions[act_idx][\"y\"] += np.random.normal(0, 0.5)\n\n    new_model = make_model(new_actions)\n        \n    try:\n        report = inspect_design(problem, new_model)\n        vol = report['volume_fraction']\n        comp = report['total_compliance']\n        stress = report['max_von_mises_stress']\n        valid = report['structurally_connected'] and report['wall_thickness_ok'] and len(report['feature_violations']) == 0\n        \n        if valid and vol <= 0.450 and stress <= 1.35:\n            if comp < best_comp:\n                best_comp = comp\n                best_report = report\n                best_actions = new_actions\n                print(f\"[{i}] New Best! Vol: {vol:.4f}, Comp: {comp:.2f}, Stress: {stress:.2f}\")\n                new_model.save_json(\"/app/design.json\")\n    except Exception as e:\n        pass\n\nprint(\"Finished fine-tuning.\")\nEOF" action.permission=* action.action=allow action.pattern=*
