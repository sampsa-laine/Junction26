# Environment configuration template
# Copy to .env and fill in your API key before running OpenCode in Harbor

# Grid resolution defaults
DEFAULT_NX=60
DEFAULT_NY=30

# Harbor OpenCode default model and reasoning effort (used by `uv run harbor-tasks run --agent opencode`)
HARBOR_MODEL=gemini/gemini-3.1-pro-preview
HARBOR_REASONING_EFFORT=medium

# API keys for Harbor + OpenCode evaluation (fill in GEMINI_API_KEY when ready)
# GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=
